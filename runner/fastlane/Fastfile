default_platform(:ios)

platform :ios do
  desc "Build iOS app (.ipa) only"
  lane :build_app do
    setup_ci
    build_num = ENV["BUILD_NUMBER"] || "1"

    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] && !ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].empty?
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_filepath: ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"],
        in_house: false
      )
    end

    profile_uuid = nil
    profile_name = nil
    match_url = "{{MATCH_GIT_URL}}"

    if match_url && (match_url.start_with?("http") || match_url.start_with?("git@"))
      begin
        match(
          type: "appstore",
          app_identifier: "{{BUNDLE_ID}}",
          git_url: match_url,
          readonly: false
        )
        profile_uuid = ENV["SIGH_UUID"]
        profile_name = ENV["SIGH_NAME"]
        update_code_signing_settings(
          use_automatic_signing: false,
          path: "Runner.xcodeproj",
          team_id: ENV["FASTLANE_TEAM_ID"],
          profile_name: "match AppStore {{BUNDLE_ID}}",
          code_sign_identity: "Apple Distribution"
        )
      rescue => e
        UI.important("Match signing failed: #{e.message}. Falling back to API Key Provisioning Profile.")
      end
    end

    if !profile_uuid
      UI.message("ℹ️ Fetching App Store provisioning profile via App Store Connect API Key...")
      begin
        get_provisioning_profile(
          app_identifier: "{{BUNDLE_ID}}",
          type: "appstore",
          force: true
        )
        profile_uuid = ENV["SIGH_UUID"]
        profile_name = ENV["SIGH_NAME"]
        UI.message("✅ App Store Provisioning Profile downloaded: #{profile_name} (#{profile_uuid})")
      rescue => e
        UI.important("⚠️ Provisioning profile fetch warning: #{e.message}")
      end

      if profile_uuid && !profile_uuid.empty?
        update_code_signing_settings(
          use_automatic_signing: false,
          path: "Runner.xcodeproj",
          team_id: ENV["FASTLANE_TEAM_ID"],
          profile_name: profile_uuid,
          code_sign_identity: "Apple Distribution"
        )
      else
        update_code_signing_settings(
          use_automatic_signing: true,
          path: "Runner.xcodeproj",
          team_id: ENV["FASTLANE_TEAM_ID"]
        )
      end
    end

    export_opts = {
      method: "app-store"
    }

    if profile_uuid && !profile_uuid.empty?
      export_opts[:provisioningProfiles] = {
        "{{BUNDLE_ID}}" => profile_uuid
      }
    end

    # Build the app with explicit build number override and allow_provisioning_updates
    gym(
      scheme: "{{SCHEME}}",
      export_method: "app-store",
      export_options: export_opts,
      allow_provisioning_updates: true,
      clean: false,
      output_directory: "./build",
      output_name: "{{SCHEME}}.ipa",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV['FASTLANE_TEAM_ID']} CURRENT_PROJECT_VERSION=#{build_num} FLUTTER_BUILD_NUMBER=#{build_num}"
    )
  end

  desc "Upload built .ipa to TestFlight"
  lane :upload_app do
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] && !ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].empty?
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_filepath: ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"],
        in_house: false
      )
    end

    ipa_path = "./build/{{SCHEME}}.ipa"
    unless File.exist?(ipa_path)
      # Fallback: search for any .ipa in build dir
      found_ipas = Dir.glob("./build/*.ipa")
      ipa_path = found_ipas.first if found_ipas.any?
    end

    pilot(
      ipa: ipa_path,
      app_identifier: "{{BUNDLE_ID}}",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "Full build and upload pipeline"
  lane :build_and_upload do
    build_app
    upload_app
  end
end

