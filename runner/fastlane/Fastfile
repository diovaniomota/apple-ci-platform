default_platform(:ios)

platform :ios do
  desc "Build iOS app (.ipa) only"
  lane :build_app do
    setup_ci

    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] && !ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].empty?
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_filepath: ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"],
        in_house: false
      )
    end

    # Code signing via Match if git_url is provided
    match_url = "{{MATCH_GIT_URL}}"
    if match_url && (match_url.start_with?("http") || match_url.start_with?("git@"))
      begin
        match(
          type: "appstore",
          app_identifier: "{{BUNDLE_ID}}",
          git_url: match_url,
          readonly: false
        )
        update_code_signing_settings(
          use_automatic_signing: false,
          path: "Runner.xcodeproj",
          team_id: ENV["FASTLANE_TEAM_ID"],
          profile_name: "match AppStore {{BUNDLE_ID}}",
          code_sign_identity: "Apple Distribution"
        )
      rescue => e
        UI.important("Match signing failed: #{e.message}. Falling back to Automatic Signing.")
        update_code_signing_settings(
          use_automatic_signing: true,
          path: "Runner.xcodeproj",
          team_id: ENV["FASTLANE_TEAM_ID"]
        )
      end
    else
      UI.message("ℹ️ No Match Git URL provided, using Automatic Signing with Team ID #{ENV['FASTLANE_TEAM_ID']}")
      update_code_signing_settings(
        use_automatic_signing: true,
        path: "Runner.xcodeproj",
        team_id: ENV["FASTLANE_TEAM_ID"]
      )
    end

    # Build the app with explicit build number override and allowProvisioningUpdates
    gym(
      scheme: "{{SCHEME}}",
      export_method: "app-store",
      export_options: {
        allowProvisioningUpdates: true
      },
      clean: true,
      output_directory: "./build",
      output_name: "{{SCHEME}}.ipa",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV['FASTLANE_TEAM_ID']} CURRENT_PROJECT_VERSION=#{build_num} FLUTTER_BUILD_NUMBER=#{build_num}"
    )
  end

  desc "Upload built .ipa to TestFlight"
  lane :upload_app do
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] && !ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].empty?
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_filepath: ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"],
        in_house: false
      )
    end

    ipa_path = "./build/{{SCHEME}}.ipa"
    unless File.exist?(ipa_path)
      # Fallback: search for any .ipa in build dir
      found_ipas = Dir.glob("./build/*.ipa")
      ipa_path = found_ipas.first if found_ipas.any?
    end

    pilot(
      ipa: ipa_path,
      app_identifier: "{{BUNDLE_ID}}",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "Full build and upload pipeline"
  lane :build_and_upload do
    build_app
    upload_app
  end
end

