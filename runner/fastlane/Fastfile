default_platform(:ios)

platform :ios do
  desc "Sync certificates, build, and upload to TestFlight"
  lane :build_and_upload do
    setup_ci

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"],
      in_house: false
    )

    # Code signing via Match
    match(
      type: "appstore",
      app_identifier: "{{BUNDLE_ID}}",
      git_url: "{{MATCH_GIT_URL}}",
      readonly: false
    )

    # Auto-increment build number from TestFlight to prevent duplicate build errors
    build_num = 1
    begin
      latest_build = latest_testflight_build_number(
        app_identifier: "{{BUNDLE_ID}}"
      )
      if latest_build && latest_build.to_i > 0
        build_num = latest_build.to_i + 1
      end
    rescue => e
      UI.important("Could not fetch latest TestFlight build number: #{e.message}")
    end

    UI.message("🚀 Auto-incrementing build number to: #{build_num}")

    begin
      increment_build_number(
        build_number: build_num.to_s,
        xcodeproj: "Runner.xcodeproj"
      )
    rescue => e
      UI.important("increment_build_number warning: #{e.message}")
    end

    # Update Xcode project signing settings directly for the Runner target
    # This prevents CocoaPods targets from inheriting the profile override
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV["FASTLANE_TEAM_ID"],
      profile_name: "match AppStore {{BUNDLE_ID}}",
      code_sign_identity: "Apple Distribution"
    )

    # Build the app with explicit build number override
    gym(
      scheme: "{{SCHEME}}",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "{{SCHEME}}.ipa",
      xcargs: "DEVELOPMENT_TEAM=#{ENV['FASTLANE_TEAM_ID']} CURRENT_PROJECT_VERSION=#{build_num} FLUTTER_BUILD_NUMBER=#{build_num}"
    )

    # Upload to TestFlight via API Key
    pilot(
      app_identifier: "{{BUNDLE_ID}}",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "Build only (no upload) — useful for testing"
  lane :build_only do
    gym(
      scheme: "{{SCHEME}}",
      export_method: "ad-hoc",
      clean: true,
      output_directory: "./build",
      output_name: "{{SCHEME}}.ipa"
    )
  end
end
