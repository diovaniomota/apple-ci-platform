datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id            String   @id @default(uuid())
  name          String
  repoUrl       String
  branch        String   @default("main")
  buildScheme   String
  bundleId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  builds        Build[]
}

model Build {
  id          String   @id @default(uuid())
  projectId   String
  status      String   @default("PENDING") // PENDING, RUNNING, SUCCESS, FAILED, CANCELLED
  logs        String   @default("")
  commit      String?  @default("")
  machine     String?  @default("Mac mini (Intel Core i5)")
  artifacts   String?  @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model RunnerHealth {
  id          String   @id @default(uuid())
  runnerId    String   @unique
  hostname    String   @default("Mac-mini")
  machine     String   @default("Mac mini")
  status      String   @default("ONLINE") // ONLINE, BUILDING, OFFLINE
  cpuUsage    Float    @default(0.0)
  memUsage    Float    @default(0.0)
  memTotal    String   @default("16 GB")
  diskUsage   Float    @default(0.0)
  diskFree    String   @default("100 GB")
  activeBuild String?
  lastSeen    DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

